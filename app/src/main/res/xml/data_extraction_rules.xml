<?xml version="1.0" encoding="utf-8"?>
<!--
  SAMAVETA keeps personal data on the device. Cloud backup and device-to-device transfer are
  disabled for everything except the user's own preference file, which is non-sensitive.
  Memories, conversations, voiceprints, embeddings and audit records are explicitly excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
