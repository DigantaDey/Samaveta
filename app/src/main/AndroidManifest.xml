<?xml version="1.0" encoding="utf-8"?>
<!--
  SAMAVETA — समवेत

  Permission policy: SAMAVETA requests the *minimum* set needed for its core, local-first
  experience. Every capability that reads the outside world is requested at runtime, only when the
  user enables that capability, and is documented in docs/PRIVACY.md together with the exact data
  it touches. There is no telemetry permission pair, no AD_ID, and no broad storage access.

  Deliberately NOT requested:
    * AccessibilityService (the product must never use it as a general UI-automation channel)
    * QUERY_ALL_PACKAGES
    * READ_EXTERNAL_STORAGE / MANAGE_EXTERNAL_STORAGE (SAF is used instead)
    * RECORD_AUDIO at install time (requested on demand for voice, with an explicit explanation)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reading user-chosen information sources: public web/RSS only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- On-device inference is CPU/GPU bound and must keep running while the screen is off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Intelligence delivery. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Device health: thermal + battery aware scheduling (API 29+ for thermal). -->
    <uses-permission
        android:name="android.permission.READ_THERMAL_STATE"
        tools:targetApi="29" />

    <!--
      Voice. Runtime-requested and revoked independently; the app remains fully usable (text and
      vision) without it. Declared so the user can see the intent up-front in system settings.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Hardware that materially changes which models are usable. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.ram.low" android:required="false" />
    <!-- The model runtimes ship arm64-only native code. -->
    <uses-feature android:name="android.hardware.cpu.arm64" android:required="true" />

    <application
        android:name=".app.SamavetaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Samaveta"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Samaveta.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share sheet entry: send an image or text straight to the Agent. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Model downloads/verification run in a data-sync foreground service with a visible
             notification; they are never silent. -->
        <service
            android:name=".models.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager is initialised through Hilt so jobs can receive repositories. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
